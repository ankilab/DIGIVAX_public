# DIGIVAX_runnable configuration — sourced by install.sh, run.sh and job.sbatch.
# Every value can be overridden from the environment, e.g.
#   SLURM_PARTITION=a100 SLURM_GRES=gpu:a100:1 ./run.sh images/
#
# Everything large (venv ~6 GB, adapter, caches) lives on $WORK: /home/hpc has a
# 100 GB quota, so this repo itself must stay small.

WORK="${WORK:-$HOME}"
DIGIVAX_HOME="${DIGIVAX_HOME:-$WORK/DIGIVAX_runnable}"

# Python environment (created by install.sh)
PYTHON_BIN="${PYTHON_BIN:-/apps/python/3.12-miniforge/bin/python3.12}"
VENV_DIR="${VENV_DIR:-$DIGIVAX_HOME/venv}"

# Base model (downloaded by install.sh if missing).
BASE_MODEL_REPO="${BASE_MODEL_REPO:-Qwen/Qwen3.5-9B}"
BASE_MODEL_DIR="${BASE_MODEL_DIR:-$WORK/models/Qwen3.5-9B}"

# Fine-tuned LoRA adapter (copied by install.sh from ADAPTER_SOURCE). The adapter
# is not part of this repository: set ADAPTER_SOURCE to a LoRA adapter directory
# (adapter_config.json + adapter_model.safetensors) before running install.sh.
# 5-fold run 20260818T221350Z, fold 1, epoch 3 — timopt prompt, hybrid targets.
# Fold-1 test: record_f1 0.968 (finetuned + DB verification).
ADAPTER_DIR="${ADAPTER_DIR:-$DIGIVAX_HOME/adapter/20260818T221350Z_fold1_epoch3}"
ADAPTER_SOURCE="${ADAPTER_SOURCE:-}"

# Slurm resources per GPU task (Alex). Inference fits on one A40 (48 GB).
SLURM_PARTITION="${SLURM_PARTITION:-a40}"
SLURM_GRES="${SLURM_GRES:-gpu:a40:1}"
SLURM_CPUS="${SLURM_CPUS:-16}"
SLURM_EXTRA="${SLURM_EXTRA:-}"          # extra sbatch options, e.g. "--constraint=a100_80"

# Walltime estimate per task = SETUP_SECONDS + images × SECONDS_PER_IMAGE (capped at 24 h).
# Measured on A40: model load ~60 s; 17–260 s per image (dense 9-record pages that
# need the second pass are slowest), ~130 s on average. 180 s leaves headroom.
SETUP_SECONDS="${SETUP_SECONDS:-900}"
SECONDS_PER_IMAGE="${SECONDS_PER_IMAGE:-180}"
# Above this many images run.sh splits the work into parallel 1-GPU array tasks
# (450 × 180 s + 900 s ≈ 22.7 h, inside the 24 h limit).
MAX_IMAGES_PER_TASK="${MAX_IMAGES_PER_TASK:-450}"

# Run the venv's python. The miniforge base interpreter's sqlite3 links an ICU
# that needs miniforge's newer libstdc++; once torch has loaded the older system
# one, `import sqlite3` fails with "CXXABI_1.3.15 not found". Prepending the base
# interpreter's lib dir fixes that — scoped to python only, so git/slurm are unaffected.
py() {
  local base_lib
  base_lib="$(dirname "$(sed -n 's/^home *= *//p' "$VENV_DIR/pyvenv.cfg" 2>/dev/null)")/lib"
  LD_LIBRARY_PATH="$base_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$VENV_DIR/bin/python" "$@"
}

# Keep caches off the /home/hpc quota.
export HF_HOME="${HF_HOME:-$DIGIVAX_HOME/hf_cache}"
export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$DIGIVAX_HOME/triton_cache}"
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$DIGIVAX_HOME/pip_cache}"
